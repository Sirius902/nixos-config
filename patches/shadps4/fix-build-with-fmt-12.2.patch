From c8c554465e2703c366a60266c89fb8bd26a493ce Mon Sep 17 00:00:00 2001
From: Sirius902 <10891979+Sirius902@users.noreply.github.com>
Date: Sun, 27 Sep 2026 15:13:36 -0700
Subject: [PATCH] Fix build with fmt 12.2

With ENABLE_SYSTEM_LIBRARIES against fmt 12.2, the build fails now that
log.h includes only fmt/base.h. fmt/core.h no longer includes format.h
unless FMT_DEPRECATED_HEAVY_CORE is defined, so elf.cpp has no
fmt::format, and format.h no longer includes <cstring>, so regs.cpp and
resource.h have no std::memset, std::memcpy or std::memcmp. Include
what they use.

fmt 12.2 also deprecates format_string's implicit conversion to
string_view, which Log, AssertFail and UnreachableFail rely on to pass
their format string to VLog, so every file that logs warns. Call get()
instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/common/assert.h              | 4 ++--
 src/common/logging/log.h         | 2 +-
 src/core/loader/elf.cpp          | 2 +-
 src/video_core/amdgpu/regs.cpp   | 1 +
 src/video_core/amdgpu/resource.h | 1 +
 5 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/src/common/assert.h b/src/common/assert.h
index d1d3c07..f7ddc84 100644
--- a/src/common/assert.h
+++ b/src/common/assert.h
@@ -26,7 +26,7 @@ template <typename... Args>
 SHAD_NO_INLINE void AssertFail(const char* file, int line, const char* func,
                                fmt::format_string<Args...> format, Args... args) {
     Common::Log::VLog(Common::Log::Class::Debug, Common::Log::Level::Critical, file, line, func,
-                      format, fmt::make_format_args(args...));
+                      format.get(), fmt::make_format_args(args...));
     assert_fail_impl();
 }
 
@@ -34,7 +34,7 @@ template <typename... Args>
 [[noreturn]] SHAD_NO_INLINE void UnreachableFail(const char* file, int line, const char* func,
                                                  fmt::format_string<Args...> format, Args... args) {
     Common::Log::VLog(Common::Log::Class::Debug, Common::Log::Level::Critical, file, line, func,
-                      format, fmt::make_format_args(args...));
+                      format.get(), fmt::make_format_args(args...));
     unreachable_impl();
 }
 
diff --git a/src/common/logging/log.h b/src/common/logging/log.h
index d47fc77..89a91cb 100644
--- a/src/common/logging/log.h
+++ b/src/common/logging/log.h
@@ -41,7 +41,7 @@ void VLog(Class log_class, Level level, const char* file, int line, const char*
 template <typename... Args>
 void Log(Class log_class, Level level, const char* file, int line, const char* func,
          fmt::format_string<Args...> format, Args&&... args) {
-    VLog(log_class, level, file, line, func, format, fmt::make_format_args(args...));
+    VLog(log_class, level, file, line, func, format.get(), fmt::make_format_args(args...));
 }
 
 } // namespace Common::Log
diff --git a/src/core/loader/elf.cpp b/src/core/loader/elf.cpp
index 705cea5..f3925fb 100644
--- a/src/core/loader/elf.cpp
+++ b/src/core/loader/elf.cpp
@@ -1,7 +1,7 @@
 // SPDX-FileCopyrightText: Copyright 2024 shadPS4 Emulator Project
 // SPDX-License-Identifier: GPL-2.0-or-later
 
-#include <fmt/core.h>
+#include <fmt/format.h>
 #include "common/assert.h"
 #include "common/logging/log.h"
 #include "core/file_sys/backends/host_fs.h"
diff --git a/src/video_core/amdgpu/regs.cpp b/src/video_core/amdgpu/regs.cpp
index 7454eaf..656cd2a 100644
--- a/src/video_core/amdgpu/regs.cpp
+++ b/src/video_core/amdgpu/regs.cpp
@@ -1,6 +1,7 @@
 // SPDX-FileCopyrightText: Copyright 2025 shadPS4 Emulator Project
 // SPDX-License-Identifier: GPL-2.0-or-later
 
+#include <cstring>
 #include "video_core/amdgpu/regs.h"
 
 namespace AmdGpu {
diff --git a/src/video_core/amdgpu/resource.h b/src/video_core/amdgpu/resource.h
index 8255184..1be82f7 100644
--- a/src/video_core/amdgpu/resource.h
+++ b/src/video_core/amdgpu/resource.h
@@ -3,6 +3,7 @@
 
 #pragma once
 
+#include <cstring>
 #include "common/alignment.h"
 #include "common/assert.h"
 #include "common/bit_field.h"
-- 
