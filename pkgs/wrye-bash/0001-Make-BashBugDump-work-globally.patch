From: Infernio <infernio@icloud.com>
Date: Sat, 10 Jun 2023 10:55:46 +0200
Subject: [PATCH 1/3] Make BashBugDump work globally

Store logs in cache and follow XDG standard.

Edited-by: Sirius902 <10891979+Sirius902@users.noreply.github.com>
---
 Mopy/bash/bash.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/Mopy/bash/bash.py b/Mopy/bash/bash.py
index ef782a7..6f099a0 100644
--- a/Mopy/bash/bash.py
+++ b/Mopy/bash/bash.py
@@ -457,7 +457,11 @@ def main(opts: Namespace, help_urls):
         # truncate the running one's - it exits once it can tell why, below
         if not (other_instance := _another_instance_running()):
             # setup logging - Mopy may not be writable, e.g. Program Files
-            _bugdump_handle = open(os.path.join(os.getcwd(),
+            bugdump_base = (os.getcwd() if bolt.os_name == 'nt' else
+                            os.path.join(os.getenv('XDG_CACHE_HOME') or
+                            os.path.expanduser('~/.cache'), 'wrye-bash'))
+            os.makedirs(bugdump_base, exist_ok=True)
+            _bugdump_handle = open(os.path.join(bugdump_base,
                 'BashBugDump.log'), 'w', buffering=1, encoding='utf-8')
             _install_bugdump() # install the BashBugDump hooks
         if (curr_os := platform.system()) not in ('Linux', 'Windows') and \
