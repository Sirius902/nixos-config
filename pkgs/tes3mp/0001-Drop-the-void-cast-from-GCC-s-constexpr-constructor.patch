From 5ed071b7abaad007dbd046050880dab75801bca7 Mon Sep 17 00:00:00 2001
From: Sirius902 <10891979+Sirius902@users.noreply.github.com>
Date: Mon, 23 Nov 2026 21:13:34 -0800
Subject: [PATCH 1/2] Drop the void* cast from GCC's constexpr constructor

GCC 9 and later reject the cast in a constant expression, so none of the
server's script function tables compile
(https://github.com/TES3MP/TES3MP/issues/552). Without it, converting a
function pointer to void* still needs -fpermissive.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/openmw-mp/Script/Types.hpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/apps/openmw-mp/Script/Types.hpp b/apps/openmw-mp/Script/Types.hpp
index 2e1ec39..5a998e8 100644
--- a/apps/openmw-mp/Script/Types.hpp
+++ b/apps/openmw-mp/Script/Types.hpp
@@ -101,7 +101,7 @@ struct ScriptFunctionPointer : public ScriptIdentity
     void *addr;
 #if (!defined(__clang__) && defined(__GNUC__))
     template<typename R, typename... Types>
-    constexpr ScriptFunctionPointer(Function<R, Types...> addr) : ScriptIdentity(addr), addr((void*)(addr)) {}
+    constexpr ScriptFunctionPointer(Function<R, Types...> addr) : ScriptIdentity(addr), addr(addr) {}
 #else
     template<typename R, typename... Types>
     constexpr ScriptFunctionPointer(Function<R, Types...> addr) : ScriptIdentity(addr), addr((void*)(addr)) {}
-- 
