@@ -25,6 +25,8 @@ namespace mwmp
         static void postInit();
         static bool isInitialized();
         static void destroy();
+        static void enforceSetting(const std::string &category, const std::string &setting, const std::string &value);
+        static void restoreUserSettings();
         static const Main &get();
         static void frame(float dt);
 
diff --git a/apps/openmw/mwmp/processors/player/ProcessorGameSettings.hpp b/apps/openmw/mwmp/processors/player/ProcessorGameSettings.hpp
